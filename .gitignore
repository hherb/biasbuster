*.bak

# ROBoto2 OA-benchmark seed data — third-party data (license R1 unconfirmed)
# and derived artifacts; never commit (raw CSV is ~62 MB). Reproduce locally
# via `python -m studies.oa_rob_benchmark.convert_roboto2_csv`.
dataset/roboto2_dataset.csv
dataset/roboto2/
dataset/oa_rob_benchmark_rejects.jsonl

# Scratch / logs
log.txt
annotation_evaluation.md
*.log
logs/

# Local experiment outputs (model-comparison runs, calibration sweeps, scratch
# verification reports). Regenerable — never committed. See docs/sample_reports/
# for the curated, tracked example reports.
experiments/

# Claude Code local working directory (personal settings and worktrees stay
# local; project skills under .claude/skills/ are tracked and shared)
.claude/*
!.claude/skills/
# ...except personal skills that duplicate user-level (~/.claude/skills/) ones
.claude/skills/commit-push/

# Generated comparison / eval reports (compare stage output) and pipeline state
dataset/annotation_comparison/
dataset/backfill_cochrane_checkpoint.json
dataset/rob_curation_queue.json
dataset/rob_review_queue.json
dataset/*.localbackup

# Eisele-Metzger study artifacts derived from the restricted EM-100 dataset
# (per-RCT citations/identifiers). Keep local until redistribution rights are
# clear — same policy as DATA/ above.
studies/eisele_metzger_replication/acquisition_report.md
studies/eisele_metzger_replication/missing_fulltext.csv
studies/eisele_metzger_replication/.sonnet_batch_state.json

# Large binary RoB fixtures not consumed by the (JATS-XML-only) extractor tests
tests/fixtures/cochrane_reviews/*.pdf

# Git worktrees
worktrees/

# Third-party research data with unresolved redistribution rights
# (e.g. Eisele-Metzger 2025 supplementary CSVs — keep local until copyright is clear)
DATA/

# wrong-paper recovery obtainability checkpoint (transient resume state)
studies/eisele_metzger_replication/recovery_obtainability.checkpoint.json
