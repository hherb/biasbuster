__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Config with API keys (use config.example.py as template)
config.py

# Dataset outputs
dataset.old/

# Training outputs (checkpoints, merged models, GGUF)
training_output/

# Evaluation results
eval_results/

